#cot sec csc are their own functions, cot in cot out, never turned into 1/tan
simplify; cot(X)+1; cot(X)+1
deriv; cot(X); X; -csc(X)^2
deriv; sec(X); X; tan(X)sec(X)
deriv; csc(X); X; -cot(X)csc(X)
decimal; cot(1); 0.642093
decimal; sec(1); 1.85082
decimal; csc(1); 1.1884
simplify; cot(pi/4); 1
simplify; sec(pi/3); 2
simplify; csc(pi/6); 2

#solve for a letter when the others stay letters, the quadratic formula as a tree
solve; Y=X^2+3; X; -(-3+Y)^(1/2), (-3+Y)^(1/2)
solve; A=pi*R^2; R; (-A^(1/2))/pi^(1/2), A^(1/2)/pi^(1/2)
solve; X^2+BX+C=0; X; (-B_(B^2_4C)^(1/2))/2, (-B+(B^2_4C)^(1/2))/2
solve; Y=X^2; X; -Y^(1/2), Y^(1/2)
solve; Y=2X^2+4X+1; X; (-2_(2+2Y)^(1/2))/2, (-2+(2+2Y)^(1/2))/2
solve; 3X^2=Y; X; (-Y^(1/2))/3^(1/2), Y^(1/2)/3^(1/2)

#the variable only once: peel the layers off it
solve; Y=2^X; X; logb(Y,2)
solve; X^3=Y; X; Y^(1/3)
solve; ln(X)=2; X; e^2
solve; 2^(3X+1)=Y; X; -1/3+logb(Y,2)/3
solve; X^4=16; X; -2, 2
solve; e^(2X)=5; X; ln(5)/2
solve; sin(X)=1/2; X; pi/6+2piN,2piN+(5pi)/6
solve; cos(X)=0; X; pi/2+piN
solve; tan(X)=1; X; pi/4+piN
solve; cos(2X)=1/2; X; pi/6+Npi,(-pi)/6+Npi

#integer logs come out exact
simplify; log(1000)+logb(8,2); 6
simplify; log(5)+logb(10,3); logb(10,3)+log(5)
