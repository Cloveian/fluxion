#Fluxion's own engine tests, same format as pcas.tests (PineappleCAS's, left as they are).
#_ is subtract, - is negate.
#What the engine gets wrong or hangs on is in todo.tests (not run by make), with what it gives now.

#Polynomial factoring over the rationals (FAC_POLYNOMIAL)
#ACT Q37, Q5
factor; X^3+X^2_8X_12; (X_3)(X+2)^2
factor; X^2_X_30; (X_6)(X+5)

#Not monic, repeated roots
factor; 2X^2+X_1; (2X_1)(X+1)
factor; 6X^2_5X+1; (2X_1)(3X_1)
factor; 4X^2_12X+9; (2X_3)^2
factor; X^3_3X^2+3X_1; (X_1)^3
factor; X^2+2X+1; (X+1)^2
factor; 6X^3+11X^2+6X+1; (X+1)(2X+1)(3X+1)
factor; 2X^3_X^2_2X+1; (X_1)(X+1)(2X_1)

#The number in front, powers of the variable, the sign
factor; 2X^2+4X; 2X(X+2)
factor; X^2/2_1/2; (X_1)(X+1)/2
factor; X^5_X^3; X^3(X_1)(X+1)
factor; -X_1; -(X+1)
factor; Y^2_9; (Y_3)(Y+3)
factor; X^2+X; X(X+1)
factor; 12X^2_3; 3(2X_1)(2X+1)
factor; -2X^2+8; -2(X_2)(X+2)
factor; X^4+X^2; X^2(X^2+1)

#Fraction and decimal coefficients: cleared, the number goes in front
factor; X^2_1/4; (2X_1)(2X+1)/4
factor; 0.5X^2_0.5; (X_1)(X+1)/2
factor; X^3/6_X/6; X(X_1)(X+1)/6

#Degree 4 and up, and the root search limit (lowest and highest coefficient up to 1000000)
factor; X^4_5X^2+4; (X_1)(X+1)(X_2)(X+2)
factor; X^10_1; (X_1)(X+1)(X^8+X^6+X^4+X^2+1)
factor; X^33+X^32; X^32(X+1)
factor; 1000000X^2_1; (1000X_1)(1000X+1)
factor; X^2_1000001; X^2_1000001

#No rational roots: left as it is, like the Nspire. The rest still comes out around it
factor; X^2_2; X^2_2
factor; X^2+1; X^2+1
factor; X^4_1; (X_1)(X+1)(X^2+1)
factor; X^3+8; (X+2)(X^2_2X+4)
factor; X^3_1; (X_1)(X^2+X+1)

#Nothing to factor
factor; X^2; X^2
factor; 5; 5

#Polynomials inside a product, fraction or power. Not inside functions
factor; sin(X)(X^2_1); (X_1)(X+1)sin(X)
factor; (X^2_1)sin(X)+(X^2_1)cos(X); (X_1)(X+1)(sin(X)+cos(X))
factor; (X+1)(X^2_1); (X_1)(X+1)^2
factor; (X^2_1)^2; (X_1)^2(X+1)^2
factor; (X^2_1)/(X^2_4); (X_1)(X+1)/((X_2)(X+2))
factor; 1/(X^2_1); 1/((X_1)(X+1))
factor; sin(X^2_1); sin(X^2_1)
factor; sin(X)^2_1; sin(X)^2_1

#More than one letter: difference of squares, perfect squares, sum and difference of cubes (the first two moved over from todo.tests)
factor; X^2+2XY+Y^2; (X+Y)^2
factor; X^2_Y^2; (X_Y)(X+Y)
factor; X^2_2XY+Y^2; (X_Y)^2
factor; 4X^2_9Y^2; (2X_3Y)(2X+3Y)
factor; X^3+Y^3; (X+Y)(X^2_XY+Y^2)
factor; X^3_Y^3; (X_Y)(X^2+XY+Y^2)
factor; A^2_B^2; (A_B)(A+B)
factor; X^2+Y^2; X^2+Y^2
factor; 2X^2_8Y^2; 2(X_2Y)(X+2Y)

#Solve over the reals (solve; equation; variable; roots smallest first, or true / false / unknown)
#ACT Q1, Q9, Q33
solve; (100+60+80+30+X)/5=72; X; 90
solve; 6Y=5X_1; X; (6Y+1)/5
solve; 2(3X+5)+2(X+3)=360; X; 43
#fraction coefficients, fraction roots sorted, a minus on x, and a silly degree (moved over from todo.tests)
solve; X^2=1/4; X; -1/2,1/2
solve; X^2/4=1; X; -2,2
solve; 0.5X^2=2; X; -2,2
solve; X^2/2_X/2_15=0; X; -5,6
solve; X^2=X/2; X; 0,1/2
solve; X^2=1/2; X; -sqrt(2)/2,sqrt(2)/2
solve; 4X^2=1; X; -1/2,1/2
solve; 2X^2+X=0; X; -1/2,0
solve; (2X_1)(3X+1)=0; X; -1/3,1/2
solve; 2X^3_X^2_2X+1=0; X; -1,1/2,1
solve; -X=3; X; -3
solve; -2X=4; X; -2
solve; X^33=0; X; 0

#csolve, what the app actually runs. quadratics give their complex roots too (the -i one first)
csolve; X^2+1=0; X; -i,i
csolve; X^2+2X+5=0; X; -1_2i,-1+2i
csolve; X^2=-4; X; -2i,2i
csolve; X^2+X+1=0; X; -1/2_(i3^(1/2))/2,-1/2+(i3^(1/2))/2
csolve; X^4=1; X; -1,1,-i,i
csolve; X^3=8; X; 2,-1_i3^(1/2),-1+i3^(1/2)

#cubics, exact. the 1,2,3 one factors, it's there so that still goes the old way
solve; X^3_3X+1=0; X; 2cos(8pi/9),2cos(4pi/9),2cos(2pi/9)
solve; X^3+X+1=0; X; (-108+12*93^(1/2))^(1/3)/6_((108+12*93^(1/2))^(1/3))/6
solve; X^3_6X^2+11X_6=0; X; 1,2,3
solve; X^3_2=0; X; 2^(1/3)
#odd roots of a negative stay real, these came back with an i in them (inverse(x^3+1) did)
solve; X^3+1_Y=0; X; -(1_Y)^(1/3)
simplify; (-8)^(1/3); -2
simplify; (-32)^(3/5); -8
simplify; (-8)^(2/3); 4
simplify; (-Y)^(1/3); -(Y^(1/3))
#and whole powers of complex numbers multiply out instead of going polar
simplify; (7+4i)^2; 33+56i
simplify; (1+2i)^3; -11_2i
simplify; (1+i)^8; 16
#and what those roots come to, so a pretty wrong answer can't sneak past
decimal; 2cos(8pi/9); -1.87939
decimal; 2cos(4pi/9); 0.347296
decimal; 2cos(2pi/9); 1.53209
decimal; (-108+12*93^(1/2))^(1/3)/6_((108+12*93^(1/2))^(1/3))/6; -0.682328

#Linear
solve; 2X+3=7; X; 2
solve; 2=X; X; 2
solve; 3X=0; X; 0
solve; 3_X=0; X; 3
solve; -X=-3; X; 3
solve; 2X_1=X+3; X; 4
solve; (X+1)/2=(X_1)/3; X; -5
solve; X^2+X=X^2+1; X; 1

#Linear, with other variables in the coefficients
solve; AX+B=0; X; -B/A
solve; AX+BX=C; X; C/(A+B)
solve; XY=1; X; 1/Y
solve; X+Y=0; X; -Y
solve; -X+Y=0; X; Y
solve; 2X+Y=1; X; (1_Y)/2
solve; sqrt(2)X=2; X; sqrt(2)

#Every value, or none
solve; X+1=X+1; X; true
solve; X+1=X+2; X; false
solve; 0=0; X; true
solve; 1=2; X; false
solve; X^2=X^2+1; X; false
solve; X/X=1; X; true

#Polynomials: rational roots, then quadratics by the formula
solve; X^2_X_30=0; X; -5,6
solve; X^3+X^2_8X_12; X; -2,3
solve; X^3_X; X; -1,0,1
solve; X^2=2; X; -sqrt(2),sqrt(2)
solve; X^2+1=0; X; false
solve; (X_1)(X+2)=0; X; -2,1
solve; X(X+1)(X+2)=0; X; -2,-1,0
solve; X^2=10000; X; -100,100
solve; -X^2+4=0; X; -2,2
solve; X^2=X; X; 0,1
solve; 3X^2=X; X; 0,1/3
solve; (X_1)^2=4; X; -1,3
solve; X^3_6X^2+11X_6=0; X; 1,2,3
solve; X^4_5X^2+4=0; X; -2,-1,1,2

#A repeated root once
solve; 2X^2+4X+2=0; X; -1
solve; X^2=2X_1; X; 1
solve; 9X^2_6X+1=0; X; 1/3
solve; X^2=0; X; 0
solve; X^32=0; X; 0

#Irrational roots. 2^(3/2) is 2sqrt(2) before the canonical form (like terms merge it back)
solve; X^2_2X_1=0; X; 1_sqrt(2),1+sqrt(2)
solve; X^2_6X+7=0; X; 3_sqrt(2),3+sqrt(2)
solve; X^2+2X_2=0; X; -1_sqrt(3),-1+sqrt(3)
solve; X^2=12; X; -2sqrt(3),2sqrt(3)
solve; X^2=8; X; -2^(3/2),2^(3/2)

#Only the real roots
solve; X^2=-1; X; false
solve; X^2+X+1=0; X; false
solve; X^4=1; X; -1,1
solve; X^3=8; X; 2
solve; X^3+X=0; X; 0

#Mostly solved on 10-16 now (only the unknown ones are still cant). was: no rational roots above degree 2, not a polynomial in the variable, other variables or roots in the coefficients
solve; X^3_2=0; X; 2^(1/3)
solve; sin(X)=0; X; piN
solve; e^X=1; X; 0
solve; sqrt(X)=2; X; 4
solve; 1/X=2; X; 1/2
solve; X^2=Y; X; -Y^(1/2), Y^(1/2)
solve; X^2_2sqrt(2)X+2=0; X; 2^(1/2)
solve; Y=1; X; unknown
solve; X^2_1=0; Y; unknown

#holes and asymptotes (asym; expression; variable; holes <x list> | vert <x list> | horiz <y> | slant <y>, - for none)
asym; (X^2_1)/(X_1); X; holes 1 | vert - | horiz - | slant -
asym; 1/(X_2); X; holes - | vert 2 | horiz 0 | slant -
asym; (2X^2+1)/(X^2_4); X; holes - | vert -2,2 | horiz 2 | slant -
asym; (X_1)^2/(X_1); X; holes 1 | vert - | horiz - | slant -
asym; (X_1)/(X_1)^2; X; holes - | vert 1 | horiz 0 | slant -
asym; (X^2+3X+2)/(X^2_1); X; holes -1 | vert 1 | horiz 1 | slant -
asym; 1/X+1/(X_1); X; holes - | vert 0,1 | horiz 0 | slant -
asym; X^2+1; X; holes - | vert - | horiz - | slant -
asym; (3X+1)/(2X_5); X; holes - | vert 5/2 | horiz 3/2 | slant -
asym; X/(X^2+1); X; holes - | vert - | horiz 0 | slant -
asym; (X^2+1)/X; X; holes - | vert 0 | horiz - | slant X
asym; (X^2+3X+2)/(X_1); X; holes - | vert 1 | horiz - | slant 4+X
asym; (2X^3+1)/(X^2); X; holes - | vert 0 | horiz - | slant 2X
asym; (X^3)/(X^2+1); X; holes - | vert - | horiz - | slant X
asym; (X^2+X)/X; X; holes 0 | vert - | horiz - | slant -

#domain (domain; expression; variable; lower <x> | upper <x> | holes <x list>, o after a bound for open, - for none)
domain; sqrt(X_2); X; lower 2 | upper - | holes -
domain; 1/(X_1); X; lower - | upper - | holes 1
domain; ln(X); X; lower 0o | upper - | holes -
