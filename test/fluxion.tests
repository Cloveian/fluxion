#x^n = c with x there once, all n of them going round
csolve; 2X^6+3=0; X; 3^(2/3)/2^(7/6)+(i3^(1/6))/2^(7/6),(i3^(1/6))/2^(1/6),(-3^(2/3))/2^(7/6)+(i3^(1/6))/2^(7/6),(-3^(2/3))/2^(7/6)_(3^(1/6)i)/2^(7/6),(-3^(1/6)i)/2^(1/6),(-3^(1/6)i)/2^(7/6)+3^(2/3)/2^(7/6)
csolve; X^5=1; X; 1,cos((2pi)/5)+isin((2pi)/5),cos((4pi)/5)+isin((4pi)/5),cos((4pi)/5)_isin((4pi)/5),cos((2pi)/5)_isin((2pi)/5)
csolve; X^5=-32; X; 2cos(pi/5)+2isin(pi/5),2cos((3pi)/5)+2isin((3pi)/5),-2,2cos((3pi)/5)_2isin((3pi)/5),2cos(pi/5)_2isin(pi/5)
solve; X^5=32; X; 2
solve; X^7+3=0; X; -3^(1/7)
